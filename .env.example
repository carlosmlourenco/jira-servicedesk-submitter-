# =============================================================
# Jira Service Desk Submitter — configuration
# Copy this file to ".env" and fill in your own values.
# The .env file is git-ignored and must NEVER be committed.
# =============================================================

# Your Atlassian / Jira base URL (no trailing slash)
JIRA_BASE_URL="https://your-domain.atlassian.net"

# The email address of your Atlassian account
JIRA_EMAIL="yourname@example.com"

# A Jira API token (NOT your password).
# Create one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN="paste-your-api-token-here"

# The Service Desk (portal) ID and Request Type ID.
# From the portal URL:
#   .../servicedesk/customer/portal/2065/group/2232/create/2932
#   portal ID  -> 2065   (SERVICE_DESK_ID)
#   create ID  -> 2932   (REQUEST_TYPE_ID)
# NOTE: portal IDs sometimes differ from the API's serviceDeskId.
# Run ./discover-fields.sh first to confirm these are correct.
SERVICE_DESK_ID="2065"
REQUEST_TYPE_ID="2932"

# =============================================================
# Allocation planner — calendar (HiBob or other ICS feed)
# Personal calendar feed URL used by plan_from_calendar.py to pull PTO.
# Set once here so you don't repeat it on every run. This is a personal
# token URL — .env is git-ignored, so it stays private. NEVER commit it.
# Leave blank if you plan to pass a downloaded file with --file instead.
# =============================================================
HIBOB_ICS_URL=""

# =============================================================
# PIR submission server (allocation-plan/server/server.py)
# Submits the Project Initiation Request to the Jira Service Desk.
# =============================================================

# Port the local server listens on (default 8723).
PORT="8723"

# Discovered IDs for the PIR request type. The portal URL shows portal id 2065,
# but the REST API uses serviceDeskId 2067 for the same desk.
#   portal: .../customer/portal/2065/group/2232/create/2866
SERVICE_DESK_ID_PIR="2067"
REQUEST_TYPE_ID_PIR="2866"
FORECAST_FIELD_ID="customfield_19943"   # "Project Forecast Page" (mandatory)

# --- OAuth 3LO (production auth) ------------------------------------------
# Register an app at https://developer.atlassian.com/console/myapps/
#   - add the "Jira Service Management" API
#   - scopes: read:servicedesk-request  write:servicedesk-request
#             read:jira-user  offline_access
#   - set the callback/redirect URL to match REDIRECT_URI below
# The client secret must stay server-side only. Never commit real values.
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""
REDIRECT_URI="http://localhost:8723/auth/callback"
# Optional: pin the site's cloudId (otherwise resolved from the token).
JIRA_CLOUD_ID=""

# --- Dev fallback ----------------------------------------------------------
# If OAuth isn't set up yet, the server falls back to Basic auth using the
# JIRA_EMAIL / JIRA_API_TOKEN above. Fine for local testing; do NOT use in
# production (the token would act on your behalf without SSO).
